<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Release builds are HTTPS only (constitution §5). The one exception is a release APK for
         testing against a local development server: flutter build apk -P niraahLocalHttp=true
         (set from android/app/build.gradle.kts). Never use that flag for a store build. -->
    <application android:usesCleartextTraffic="${usesCleartextTraffic}"/>
</manifest>
