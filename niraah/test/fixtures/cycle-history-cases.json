    {
      "name": "nine days of flow is not long bleeding",
      "today": "2026-11-14",
      "periods": [{ "start": "2026-11-06" }],
      "markers": [],
      "dailyFlow": {
        "2026-11-06": "heavy", "2026-11-07": "heavy", "2026-11-08": "medium", "2026-11-09": "light", "2026-11-10": "light",
        "2026-11-11": "spotting", "2026-11-12": "light", "2026-11-13": "medium", "2026-11-14": "light"
